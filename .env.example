# Copy this file to .env for local runs. The values are local-only placeholders.
# Each worktree needs its own POSTGRES_PORT, because parallel workers run their own databases.
POSTGRES_PORT=5432
DB_URL_APP=jdbc:postgresql://localhost:${POSTGRES_PORT}/focusledger?user=focusledger_app
DB_URL_MIGRATE=jdbc:postgresql://localhost:${POSTGRES_PORT}/focusledger?user=focusledger_migrate
SESSION_SIGNING_KEY=local-only-replace-with-a-random-value
GOOGLE_CLIENT_ID=your-development-oauth-client-id.apps.googleusercontent.com
# At least 32 bytes. It signs the agents' access tokens and login codes.
MCP_TOKEN_SIGNING_KEY=local-only-replace-with-a-random-value
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
